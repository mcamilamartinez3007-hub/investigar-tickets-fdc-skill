{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/fdc/knowledge-entry.schema.json",
  "title": "FDC Knowledge Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "knowledge_id",
    "title",
    "domain",
    "component",
    "knowledge_type",
    "lifecycle_status",
    "claim",
    "fingerprint",
    "source_tickets",
    "source_references",
    "date_observed",
    "environment",
    "affected_systems",
    "affected_objects",
    "evidence",
    "confidence",
    "validity",
    "applicability",
    "novelty",
    "conflict",
    "validation",
    "reuse",
    "promotion",
    "security_review",
    "revalidation"
  ],
  "properties": {
    "knowledge_id": {"type": "string", "pattern": "^FDC-KNOWLEDGE-[0-9]{4,}$"},
    "title": {"type": "string", "minLength": 8},
    "domain": {"type": "string", "minLength": 2},
    "component": {"type": "string", "minLength": 2},
    "knowledge_type": {
      "enum": ["SYSTEM_CONTRACT", "FAILURE_MECHANISM", "DIAGNOSTIC_PATTERN", "OPERATIONAL_PLAYBOOK", "OWNERSHIP_RULE", "ENVIRONMENT_RULE", "BUSINESS_RULE", "HISTORICAL_DECISION", "NEGATIVE_KNOWLEDGE"]
    },
    "lifecycle_status": {
      "enum": ["candidate", "provisional", "verified", "operational", "conflict_pending", "superseded", "rejected"]
    },
    "claim": {"type": "string", "minLength": 20},
    "fingerprint": {"type": "string", "minLength": 12},
    "source_tickets": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "source_references": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "date_observed": {"type": "string", "minLength": 8},
    "environment": {"type": "string", "minLength": 2},
    "version_scope": {"type": "object"},
    "affected_systems": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "affected_objects": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "confidence": {"enum": ["low", "medium", "high"]},
    "validity": {"enum": ["unverified", "environment-specific", "current", "historical", "superseded", "contradicted"]},
    "applicability": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "novelty": {"type": "object"},
    "conflict": {"type": "object"},
    "validation": {"type": "object"},
    "reuse": {"type": "object"},
    "promotion": {"type": "object"},
    "security_review": {"type": "object"},
    "related_knowledge_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "supersedes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "superseded_by": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "revalidation": {"type": "object"}
  }
}
